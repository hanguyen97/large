#---------- Load libraries ----------#
library(MASS)
library(corrplot)
library(nlshrink)
library(Matrix)
library(large)
#---------- Helper functions ----------#
get_band2_graph <- function(p, rho1=0.3, rho2=0.2, same.diag = 0,
diag_sc = c(10, 1, 0.5)) {
if (p < 12) {
stop("p must be at least 12")
}
if (same.diag == 0) {
p1 <- round(p/3)
p2 <- round(p/3)
p3 <- p - (p1+p2)
p_blocks <- c(p1, p2, p3)
Theta_blocks <- list()
for (i in 1:3) {
p <- p_blocks[i]
A <- matrix(data=0, nrow=p, ncol=p)
diag(A) <- 1
diag(A[1:(p-1), 2:p]) <- rho1
diag(A[2:p, 1:(p-1)]) <- rho1
diag(A[1:(p-2), 3:p]) <- rho2
diag(A[3:p, 1:(p-2)]) <- rho2
Theta_blocks[[i]] <- diag_sc[i] * A
}
Theta <- as.matrix(bdiag(Theta_blocks[[1]], Theta_blocks[[2]], Theta_blocks[[3]]))
return(Theta)
}
}
#---------- Simulate data ----------#
set.seed(2)
p <- 50
n <- 50
Theta <- get_band2_graph(p=p)
Sigma <- solve(Theta)
X <- mvrnorm(n=n, mu=rep(0,p), Sigma=Sigma)
corrplot(cov2cor(Theta), method = "color", tl.pos="n")
#---------- Test ----------#
pen <- FALSE
att_thr=0.005
# run <- function(...) fit_large(X = X, alpha = 0.02, thr = att_thr, maxit = 30, penalize_diag = pen, ...)
# o0 <- run()                                       # original behaviour
# o1 <- run(auto_freeze = TRUE)                     # fixes the cycle
# o2 <- run(sym_thresh = TRUE)                      # fixes the asymmetry
# o3 <- run(auto_freeze = TRUE, sym_thresh = TRUE)  # both
# sapply(list(o0, o1, o2, o3), function(o) c(converged = o$converged, niter = o$niter, frozen_at = o$frozen_at))
out <- fit_large(X=X, alpha=0.02, thr=att_thr, maxit=20,
penalize_diag=pen, verbose=TRUE)
devtools::install()
rm(list = ls())
